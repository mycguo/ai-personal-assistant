# Google Generative AI API Key
GENAI_API_KEY=your_google_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# AssemblyAI API Key (for audio transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# NVIDIA API Key
NVIDIA_API_KEY=your_nvidia_api_key_here

# AWS Configuration (optional - for S3 backup)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BUCKET_NAME=your_s3_bucket_name

# Milvus Configuration
# For local deployment (using Milvus Lite - embedded database)
MILVUS_URI=./milvus_local.db

# For standalone Milvus server
# MILVUS_URI=http://localhost:19530

# For Milvus Cloud/Zilliz Cloud
# MILVUS_URI=https://your-cluster.api.milvus.io
# MILVUS_TOKEN=your_milvus_cloud_token